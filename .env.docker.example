# ============================================================
# School App — Environment untuk Docker Compose
#
# Salin ke .env di root repo, lalu ganti semua nilai "ganti-...":
#     cp .env.docker.example .env
#
# Compose hanya menjalankan DUA layanan: `web` dan `wa-gateway`.
# PostgreSQL & Nginx dikelola di stack TERPISAH (network eksternal
# `db-network` dan `app-network`), jadi tidak ada konfigurasi keduanya di sini.
# ============================================================

# --- Database (PostgreSQL) ---
# WAJIB: arahkan ke container DB yang sudah berjalan di jaringan `db-network`.
# Gunakan NAMA SERVICE/CONTAINER DB sebagai host (bukan localhost), mis:
#   postgresql://school:RAHASIA@school-db:5432/schoolapp?schema=public
DATABASE_URL="postgresql://school:ganti-password@nama-container-db:5432/schoolapp?schema=public"

# --- NextAuth ---
# URL publik aplikasi (di belakang Nginx). Wajib sama dengan domain yang diakses.
NEXTAUTH_URL="https://ganti-domain-anda.sch.id"
# Rahasia sesi. Hasilkan: openssl rand -base64 32  (minimal 32 karakter)
NEXTAUTH_SECRET="ganti-secret-acak-minimal-32-karakter"

# --- Aplikasi ---
NODE_ENV="production"
DEFAULT_TIMEZONE="Asia/Jakarta"
# Root domain untuk multi-tenant subdomain: sekolah1.<ROOT_DOMAIN>.
# Dipakai juga saat BUILD web (di-inline ke bundle klien) — lihat build.args.
ROOT_DOMAIN="ganti-domain-anda.sch.id"

# --- WA Gateway (Baileys) ---
# Di dalam compose, web memanggil wa-gateway lewat nama service `wa-gateway`.
# Biarkan apa adanya (di-override compose ke http://wa-gateway:3001).
WA_GATEWAY_URL="http://wa-gateway:3001"
# Token rahasia bersama web <-> wa-gateway. Hasilkan: openssl rand -hex 32
WA_GATEWAY_TOKEN="ganti-token-gateway-panjang-acak"
# Direktori sesi di dalam container (di-mount volume school_wa_sessions).
WA_SESSION_DIR="/data/sessions"

# --- Jam wajar kirim WA (WIB) ---
WA_SEND_HOUR_START=7
WA_SEND_HOUR_END=21
WA_MAX_RETRY=3

# --- Seed super admin awal (dipakai `npm run db:seed`) ---
SEED_SUPERADMIN_EMAIL="admin@ganti-domain-anda.sch.id"
SEED_SUPERADMIN_PASSWORD="ganti-password-kuat"

# --- Kunci enkripsi kredensial payment gateway (AES-256-GCM) ---
# Hasilkan: openssl rand -hex 32
# PERINGATAN: kehilangan kunci ini = kredensial gateway harus dimasukkan ulang.
PAYMENT_ENCRYPTION_KEY="ganti-64-karakter-hex"

# --- Storage upload (logo, sampul, dokumen SPMB) ---
# driver `local` menulis ke volume school_uploads (UPLOAD_DIR=/data/uploads,
# di-set compose). JANGAN pakai `local` bila menjalankan >1 replika web.
STORAGE_DRIVER="local"
