# ============================================================
# Contoh env untuk deploy Docker Compose.
#   cp .env.docker.example .env   lalu isi nilainya.
#
# PILIH SALAH SATU mode deploy dengan meng-uncomment SATU baris COMPOSE_FILE
# di bawah. Hanya satu berkas deploy yang dijalankan, dengan atau tanpa DB.
# ============================================================

# --- Mode A: TANPA DB (DB eksternal / terkelola) ---
# DATABASE_URL wajib diisi sendiri. Tidak perlu POSTGRES_*/APP_DB_*.
COMPOSE_FILE=docker-compose.yml

# --- Mode B: DENGAN DB (Postgres ikut stack) ---
# DATABASE_URL TIDAK perlu diisi — disusun otomatis oleh docker-compose.db.yml.
# Wajib: POSTGRES_PASSWORD dan APP_DB_PASSWORD.
#
# Linux / macOS:  pemisah TITIK DUA
# Windows:        pemisah TITIK KOMA
#
# COMPOSE_FILE=docker-compose.yml:docker-compose.db.yml

# ------------------------------------------------------------
# Mode A saja. Pada Mode B dibiarkan apa adanya — nilainya ditimpa.
# ------------------------------------------------------------
DATABASE_URL="postgresql://vibe:***@host-db-anda:5432/vibe-schools?schema=app&sslmode=no-verify"

# ------------------------------------------------------------
# Wajib di kedua mode
# ------------------------------------------------------------
NEXTAUTH_SECRET="ganti-secret-acak-minimal-32-karakter"
NEXTAUTH_URL="https://sekolah.domain-anda.id"
NODE_ENV="production"
ROOT_DOMAIN="ganti-domain-anda.sch.id"
PAYMENT_ENCRYPTION_KEY="ganti-64-karakter-hex"
WA_GATEWAY_URL="http://wa-gateway:3001"
WA_GATEWAY_TOKEN="ganti-token-gateway-panjang-acak"
WA_SESSION_DIR="/data/sessions"
STORAGE_DRIVER="local"

# Super admin awal. Hanya dipakai saat menjalankan seed, tidak saat start.
SEED_SUPERADMIN_EMAIL="admin@ganti-domain-anda.sch.id"
SEED_SUPERADMIN_PASSWORD="ganti-password-kuat"
SEED_DEMO_ACTIVITY="1"

# ------------------------------------------------------------
# Hanya Mode B
# POSTGRES_* = superuser + pemilik tabel, dipakai bootstrap.
# APP_DB_*   = role aplikasi NON-OWNER, dipakai isi DATABASE_URL.
# Keduanya HARUS berbeda. Kalau sama, RLS dilewati diam-diam.
# ------------------------------------------------------------
POSTGRES_USER="school"
POSTGRES_PASSWORD="ganti-password-db-kuat"
POSTGRES_DB="vibe-schools"
APP_DB_ROLE="vibe"
APP_DB_PASSWORD="ganti-password-role-aplikasi"
