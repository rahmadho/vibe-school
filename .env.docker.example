# ============================================================
# School App — Environment untuk DEPLOY (Docker Compose)
#
# Salin ke .env di ROOT repo:
#     cp .env.docker.example .env
# lalu ganti semua nilai "ganti-...".
#
# PENTING: berkas .env ini HANYA dibaca oleh docker compose (untuk
# mengisi container), bukan oleh `next` langsung. Di produksi tidak ada
# `.env` yang di-bundle ke image — rahasia murni datang dari sini.
#
# Compose hanya menjalankan DUA layanan: `web` dan `wa-gateway`.
# PostgreSQL & Nginx dikelola di stack TERPISAH, dijangkau lewat jaringan
# eksternal `db-network` dan `app-network` (namanya bisa diatur di bagian
# "Jaringan" di bawah).
#
# Semua variabel di sini juga boleh diisi lewat panel (Coolify dkk) —
# env_file di compose bersifat opsional, jadi berkas .env tidak wajib ada.
#
# Ringkasan status setiap variabel:
#   [WAJIB]     — aplikasi tidak berfungsi/tidak aman tanpanya
#   [PENTING]   — fitur tertentu mati bila kosong (mis. WA/payment)
#   [OPSIONAL]  — punya nilai bawaan yang aman
# ============================================================

# ------------------------------------------------------------
# [WAJIB] Database (PostgreSQL)
# ------------------------------------------------------------
# Dibaca langsung oleh Prisma. Host = NAMA SERVICE/CONTAINER DB pada jaringan
# `db-network` (BUKAN localhost). Contoh:
#   postgresql://school:***@nama-container-db:5432/schoolapp?schema=public
# Bila memakai docker-compose.db.yml (DB ikut compose), host = `postgres`.
DATABASE_URL="postgresql://school:***@nama-container-db:5432/schoolapp?schema=public"
# [PENTING] Koneksi OWNER (superuser/owner tabel), BUKAN role aplikasi.
# Dipakai HANYA saat inisialisasi database baru (grants.sql + rls.sql), tidak
# dibaca aplikasi saat berjalan. Tanpa ini, migrasi jalan tapi aplikasi
# kena "permission denied" karena role di DATABASE_URL belum punya grant/RLS
# policy. Lihat apps/web/AGENTS.md bagian "Izin database".
# OWNER_URL="postgresql://postgres:***@nama-container-db:5432/schoolapp?schema=public"

# ------------------------------------------------------------
# [WAJIB] NextAuth
# ------------------------------------------------------------
# URL publik aplikasi (yang diakses pengguna, di belakang Nginx). Tanpa trailing
# slash. Dipakai juga untuk menyusun URL webhook payment gateway.
# NEXTAUTH_URL="https://ganti-domain-anda.sch.id"
# Rahasia penandatangan sesi. WAJIB minimal 32 karakter.
# Hasilkan:  openssl rand -base64 32
NEXTAUTH_SECRET="ganti-secret-acak-minimal-32-karakter"

# ------------------------------------------------------------
# [WAJIB] Domain & aplikasi
# ------------------------------------------------------------
NODE_ENV="production"
# Domain akar multi-tenant. Setiap sekolah tampil di <slug>.<ROOT_DOMAIN>.
# Di produksi subdomain adalah SATU-SATUNYA jalan masuk web sekolah.
ROOT_DOMAIN="ganti-domain-anda.sch.id"

# ------------------------------------------------------------
# [PENTING] Payment gateway (enkripsi kredensial provider)
# ------------------------------------------------------------
# Kunci AES-256-GCM untuk menyimpan server key gateway sekolah. Tanpa ini,
# halaman & simpan kredensial payment gateway akan menolak.
# Hasilkan:  openssl rand -hex 32      (harus 64 karakter hex)
# PERINGATAN: kehilangan kunci ini = semua kredensial gateway harus dimasukkan
# ulang (data lama tak bisa didekripsi).
PAYMENT_ENCRYPTION_KEY="ganti-64-karakter-hex"
# AUTH_TRUST_HOST tidak perlu diisi: `trustHost: true` sudah dipatok di
# apps/web/src/lib/auth.ts.
# CLOUD: penanda manual (tidak dibaca compose). Isi "1"/"coolify" bila ingin
# membedakan perilaku di panel; kosongkan bila tak dipakai.
# CLOUD=""

# ------------------------------------------------------------
# [WAJIB di VPS manual] Jaringan
# ------------------------------------------------------------
# Nama NYATA jaringan di daemon Docker (bukan nama service). Atur bila server
# Anda sudah punya jaringan dengan nama lain — di Coolify jaringan dibuat
# otomatis, jadi biarkan default atau kosongkan. Lihat `docker network ls`.
DB_NETWORK="school-db"
APP_NETWORK="school-app-network"

# ------------------------------------------------------------
# [PENTING] WA Gateway (Baileys)
# ------------------------------------------------------------
# Di dalam compose, web memanggil wa-gateway lewat nama service. Nilai di sini
# di-override otomatis oleh docker-compose.yml (http://wa-gateway:3001) —
# biarkan apa adanya. Dua layanan WAJIB memakai TOKEN yang SAMA.
WA_GATEWAY_URL="http://wa-gateway:3001"
# Shared secret web <-> wa-gateway. Hasilkan:  openssl rand -hex 32
WA_GATEWAY_TOKEN="ganti-token-gateway-panjang-acak"
# Direktori sesi Baileys di dalam container (volume school_wa_sessions).
WA_SESSION_DIR="/data/sessions"

# ------------------------------------------------------------
# [PENTING] Penyimpanan berkas unggahan
# ------------------------------------------------------------
# Driver `local` menulis ke volume school_uploads. JANGAN pakai `local` bila
# menjalankan >1 replika web (berkas jadi terpisah per container). Driver
# `minio` belum diimplementasikan.
STORAGE_DRIVER="local"

# ------------------------------------------------------------
# [OPSIONAL] Seed super admin (dipakai HANYA saat `npm run db:seed`)
# ------------------------------------------------------------
# Tidak dibaca saat aplikasi berjalan biasa. Aman diisi lalu dihapus.
SEED_SUPERADMIN_EMAIL="admin@ganti-domain-anda.sch.id"
SEED_SUPERADMIN_PASSWORD="ganti-password-kuat"
# Set "0" untuk melewati pengisian aktivitas demo saat seed.
SEED_DEMO_ACTIVITY="1"

# ------------------------------------------------------------
# [OPSIONAL] Database ikut compose (docker-compose.db.yml --profile db)
# ------------------------------------------------------------
# Hanya dibaca bila Anda menjalankan:
#   docker compose -f docker-compose.yml -f docker-compose.db.yml --profile db up -d --build
# Untuk produksi sungguhan tetap disarankan DB terkelola/terpisah. Bila bagian
# ini dipakai, DATABASE_URL host-nya harus `postgres` dan password untuk role
# aplikasi harus sama dengan POSTGRES_PASSWORD (kecuali Anda membuat role lain
# manual lalu menjalankan grants.sql).
POSTGRES_USER="school"
# WAJIB bila profil db dipakai — compose menolak start tanpa ini. Hasilkan:
#   openssl rand -hex 24
POSTGRES_PASSWORD="ganti-password-db-kuat"
POSTGRES_DB="school"
