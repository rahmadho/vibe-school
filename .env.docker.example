# wa-gateway — konfigurasi runtime
#
# Salin file ini menjadi .env di root repo:
#   cp .env.docker.example .env
# Lalu ganti semua nilai bertanda "ganti-...".

# Password PostgreSQL. WAJIB diganti.
POSTGRES_PASSWORD="ganti-password-postgres-kuat"

# Token rahasia antara aplikasi web dan wa-gateway.
# Harus SAMA dengan WA_GATEWAY_TOKEN di apps/web/.env
# Hasilkan dengan: openssl rand -hex 32
WA_GATEWAY_TOKEN="ganti-token-gateway-panjang-acak"

# Kunci enkripsi kredensial payment gateway (AES-256-GCM).
# Hasilkan dengan: openssl rand -hex 32
# PERINGATAN: kehilangan kunci ini = kredensial gateway harus dimasukkan ulang.
PAYMENT_ENCRYPTION_KEY="ganti-64-karakter-hex"
