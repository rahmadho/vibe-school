# Deploy DENGAN database (Postgres di dalam stack yang sama).
#
# Dipakai dengan menyetel COMPOSE_FILE di .env:
#     COMPOSE_FILE=docker-compose.yml:docker-compose.db.yml
#
# Pemisahnya titik dua di Linux/macOS, TITIK KOMA di Windows.
# Lalu cukup `docker compose up -d --build`. Tidak perlu flag -f.
#
# Yang wajib ada di .env: POSTGRES_PASSWORD, APP_DB_PASSWORD, NEXTAUTH_SECRET.
# DATABASE_URL TIDAK perlu diisi — docker-compose.db.yml menyusunnya sendiri
# dari POSTGRES_DB/APP_DB_ROLE/APP_DB_PASSWORD.

COMPOSE_FILE=docker-compose.yml:docker-compose.db.yml
