# ============================================================
# School App — Contoh Environment
# Salin ke .env lalu isi nilainya. JANGAN commit .env!
# ============================================================

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://school:schoolpass@localhost:5432/schoolapp?schema=public"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="ganti-dengan-string-acak-panjang-minimal-32-karakter"

# --- Aplikasi ---
APP_URL="http://localhost:3000"
NODE_ENV="development"
DEFAULT_TIMEZONE="Asia/Jakarta"

# --- WA Gateway (Baileys) ---
# Base URL service wa-gateway
WA_GATEWAY_URL="http://localhost:3001"
# Token shared secret antara web app dan wa-gateway
WA_GATEWAY_TOKEN="ganti-token-rahasia"
# Direktori penyimpanan sesi Baileys
WA_SESSION_DIR="./apps/wa-gateway/sessions"

# --- Jam wajar kirim WA (WIB) ---
WA_SEND_HOUR_START=7
WA_SEND_HOUR_END=21
WA_MAX_RETRY=3

# --- Seed super admin awal ---
SEED_SUPERADMIN_EMAIL="admin@schoolapp.local"
SEED_SUPERADMIN_PASSWORD="ubah-segera-setelah-login"

# --- Storage upload (dokumen SPMB, bukti bayar, logo) ---
# Pilih salah satu: "local" atau "s3"
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./uploads"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_BUCKET=""
# S3_REGION=""
