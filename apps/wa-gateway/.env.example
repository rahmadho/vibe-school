# wa-gateway — konfigurasi
# Salin ke .env lalu sesuaikan.

# Koneksi DB (sama dengan aplikasi web) — gateway membaca tabel notification_queue.
DATABASE_URL="postgresql://school:schoolpass@localhost:5432/schoolapp?schema=public"

# Token rahasia. Aplikasi web mengirim ini di header x-gateway-token.
# WAJIB diganti dan SAMA dengan WA_GATEWAY_TOKEN di aplikasi web.
WA_GATEWAY_TOKEN="ganti-token-rahasia-panjang"

# Tempat menyimpan kredensial sesi WhatsApp. Jangan di dalam repo.
WA_SESSION_DIR="./data/sessions"

# Port HTTP API.
PORT=3001

# Level log: trace|debug|info|warn|error. BAILEYS_LOG_LEVEL=silent lebih tenang.
LOG_LEVEL=info
BAILEYS_LOG_LEVEL=silent
