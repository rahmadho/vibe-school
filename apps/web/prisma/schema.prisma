// ============================================================
// School App — Prisma Schema (Multi-tenant)
// Sumber kebenaran skema database.
// Konvensi: model PascalCase, field camelCase, @@map snake_case plural.
// Nominal uang = Int (Rupiah). WA number = E.164 tanpa '+' (62812...).
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// TENANT & IDENTITAS
// ============================================================

/// Satu baris = satu sekolah (tenant)
model School {
  id       String      @id @default(cuid())
  name     String
  slug     String      @unique // subdomain / identitas URL
  npsn     String?     @unique // Nomor Pokok Sekolah Nasional
  level    SchoolLevel
  address  String?
  phone    String?
  email    String?
  logoUrl  String?
  timezone String      @default("Asia/Jakarta")
  isActive Boolean     @default(true)

  // White-label (produk komersial)
  themeColor   String? // hex, mis. "#1E40AF"
  customDomain String? @unique // domain sekolah sendiri

  // Konfigurasi integrasi WA per-sekolah
  waGatewayId  String? // id device/session di wa-gateway
  waSenderName String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users            User[]
  students         Student[]
  teachers         Teacher[]
  staffs           Staff[]
  classes          Class[]
  subjects         Subject[]
  academicYears    AcademicYear[]
  registrations    Registration[]
  admissionBatches AdmissionBatch[]
  admissionPaths   AdmissionPath[]
  invoices         Invoice[]
  paymentMethods   PaymentMethod[]
  attendances      Attendance[]
  gradeItems       GradeItem[]
  announcements    Announcement[]
  notifTemplates   NotificationTemplate[]
  notifQueue       NotificationQueue[]
  auditLogs        AuditLog[]
  timeSlots        TimeSlot[]
  gatewayTxns      PaymentGatewayTransaction[]
  classHistories   StudentClassHistory[]
  subscription     Subscription?
  paymentGateways  SchoolPaymentGateway[]
  messageTemplates MessageTemplate[]
  campaigns        AnnouncementCampaign[]
  waSessions       WaSession[]

  // Web sekolah publik
  siteTheme       SiteTheme?
  siteConfig      SiteConfig?
  siteBlocks      SiteBlock[]
  pages           Page[]
  navigationItems NavigationItem[]
  posts           Post[]

  @@map("schools")
}

enum SchoolLevel {
  TK
  SD
  SMP
  SMA
  SMK
  MI
  MTs
  MA
}

// ============================================================
// USER, ROLE, AUTH
// ============================================================

model User {
  id           String    @id @default(cuid())
  schoolId     String? // null = super-admin lintas sekolah
  school       School?   @relation(fields: [schoolId], references: [id])
  email        String    @unique
  passwordHash String
  name         String
  phone        String? // E.164 tanpa '+'
  avatarUrl    String?
  role         UserRole
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  // Kaitan ke entitas lain (opsional, tergantung role)
  student   Student? @relation(fields: [studentId], references: [id])
  studentId String?  @unique
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  teacherId String?  @unique
  staff     Staff?   @relation(fields: [staffId], references: [id])
  staffId   String?  @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sessions          Session[]
  auditLogs         AuditLog[]
  paymentsRecorded  Payment[]              @relation("PaymentRecordedBy")
  gradesCreated     Grade[]                @relation("GradeCreatedBy")
  attendancesMarked Attendance[]           @relation("AttendanceMarkedBy")
  campaignsCreated  AnnouncementCampaign[] @relation("CampaignCreatedBy")

  @@index([schoolId])
  @@index([role])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN // lintas sekolah
  SCHOOL_ADMIN // admin satu sekolah
  PRINCIPAL // kepala sekolah
  TREASURER // bendahara
  TEACHER // guru
  STUDENT // siswa
  PARENT // wali murid
  STAFF // staf administrasi
  CONTENT_EDITOR // pengelola konten web sekolah (berita, pengumuman, agenda, galeri)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

// ============================================================
// AKADEMIK: TAHUN AJARAN, KELAS, MAPEL
// ============================================================

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  name      String // "2025/2026"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  semesters      Semester[]
  classes        Class[]
  gradeItems     GradeItem[]
  classHistories StudentClassHistory[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("academic_years")
}

model Semester {
  id             String       @id @default(cuid())
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  name           String // "Ganjil" / "Genap"
  type           SemesterType
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grades Grade[]

  @@index([academicYearId])
  @@map("semesters")
}

enum SemesterType {
  GANJIL
  GENAP
}

model Class {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  name           String // "7A"
  level          Int // 7
  capacity       Int          @default(32)

  homeroomTeacherId String?
  homeroomTeacher   Teacher? @relation("Homeroom", fields: [homeroomTeacherId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  students       Student[]
  schedules      Schedule[]
  attendances    Attendance[]
  grades         Grade[]
  classHistories StudentClassHistory[]
  campaigns      AnnouncementCampaign[]

  @@unique([schoolId, academicYearId, name])
  @@index([schoolId])
  @@map("classes")
}

model Subject {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])
  code     String
  name     String
  kkm      Int    @default(70) // Kriteria Ketuntasan Minimal

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  teachers   TeacherSubject[]
  schedules  Schedule[]
  gradeItems GradeItem[]
  grades     Grade[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("subjects")
}

/// Jadwal pelajaran: mapel + kelas + guru + jam
model Schedule {
  id        String  @id @default(cuid())
  schoolId  String
  classId   String
  class     Class   @relation(fields: [classId], references: [id])
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  dayOfWeek  Int // 1=Senin ... 7=Minggu
  timeSlotId String?
  timeSlot   TimeSlot? @relation(fields: [timeSlotId], references: [id])
  room       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, classId])
  @@index([teacherId])
  @@map("schedules")
}

// ============================================================
// GURU & STAF
// ============================================================

model Teacher {
  id       String  @id @default(cuid())
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id])
  nip      String? // Nomor Induk Pegawai
  fullName String
  gender   Gender
  phone    String?
  email    String?
  photoUrl String?
  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user        User?
  homeroomOf  Class[]          @relation("Homeroom")
  subjects    TeacherSubject[]
  schedules   Schedule[]
  attendances Attendance[]     @relation("TeacherAttendance")
  gradeItems  GradeItem[]

  @@unique([schoolId, nip])
  @@index([schoolId])
  @@map("teachers")
}

model Staff {
  id       String  @id @default(cuid())
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id])
  nip      String?
  fullName String
  position String? // "Tata Usaha", "Bendahara", dll
  phone    String?
  email    String?
  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User?

  @@index([schoolId])
  @@map("staffs")
}

/// Relasi guru <-> mapel yang diampu
model TeacherSubject {
  id        String  @id @default(cuid())
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
  @@map("teacher_subjects")
}

enum Gender {
  MALE
  FEMALE
}

// ============================================================
// SISWA & WALI MURID
// ============================================================

model Student {
  id         String    @id @default(cuid())
  schoolId   String
  school     School    @relation(fields: [schoolId], references: [id])
  nis        String // Nomor Induk Siswa
  nisn       String? // Nomor Induk Siswa Nasional
  fullName   String
  gender     Gender
  birthPlace String?
  birthDate  DateTime?
  religion   String?
  address    String?
  phone      String?
  photoUrl   String?

  // Data masuk
  entryYear Int
  classId   String?
  class     Class?        @relation(fields: [classId], references: [id])
  status    StudentStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user           User?
  parents        Parent[]
  attendances    Attendance[]
  grades         Grade[]
  invoices       Invoice[]
  registration   Registration?
  classHistories StudentClassHistory[]

  @@unique([schoolId, nis])
  @@index([schoolId])
  @@index([classId])
  @@map("students")
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  TRANSFERRED
  DROPPED_OUT
  SUSPENDED
}

model Parent {
  id         String         @id @default(cuid())
  studentId  String
  student    Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fullName   String
  relation   ParentRelation
  phone      String // E.164 tanpa '+'
  email      String?
  occupation String?
  isPrimary  Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@map("parents")
}

enum ParentRelation {
  FATHER
  MOTHER
  GUARDIAN
}

// ============================================================
// SPMB — PENERIMAAN MURID BARU
// ============================================================

model AdmissionBatch {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id])
  academicYearId String
  name           String // "SPMB 2025/2026 Gelombang 1"
  openDate       DateTime
  closeDate      DateTime
  quota          Int
  isActive       Boolean  @default(true)

  /// Informasi umum yang tampil di halaman pendaftaran publik.
  description        String?
  /// Syarat & ketentuan yang harus disetujui pendaftar.
  requirements       String?
  /// Pengumuman hasil (diisi panitia saat seleksi selesai).
  resultAnnouncement String?
  resultDate         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registrations Registration[]
  paths         AdmissionPath[]

  @@index([schoolId])
  @@map("admission_batches")
}

/// Jalur pendaftaran di dalam satu gelombang (mis. Reguler / Prestasi / Afirmasi).
///
/// Sekolah yang sederhana cukup memakai satu jalur (dibuat otomatis sebagai
/// "Reguler"), sehingga fitur ini tidak memaksa siapa pun. Sekolah yang punya
/// beberapa jalur dapat mengatur kuota dan biaya pendaftaran per jalur.
model AdmissionPath {
  id       String         @id @default(cuid())
  schoolId String
  school   School         @relation(fields: [schoolId], references: [id])
  batchId  String
  batch    AdmissionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  name        String // "Jalur Prestasi"
  code        String // "PRESTASI" — ringkas, untuk nomor pendaftaran
  description String?

  /// Kuota penerimaan khusus jalur ini.
  quota           Int  @default(0)
  /// Biaya pendaftaran (integer rupiah). 0 = gratis.
  /// NULLABLE: biaya SPMB opsional per gelombang/jalur.
  registrationFee Int?

  /// Syarat khusus jalur ini (mis. "fotokopi piagam juara").
  requirements String?
  /// Urutan tampil di formulir.
  order        Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registrations Registration[]

  @@unique([batchId, code])
  @@index([schoolId])
  @@map("admission_paths")
}

model Registration {
  id             String             @id @default(cuid())
  schoolId       String
  school         School             @relation(fields: [schoolId], references: [id])
  batchId        String
  batch          AdmissionBatch     @relation(fields: [batchId], references: [id])
  /// Jalur pendaftaran yang dipilih. Nullable agar data lama tetap sah
  /// (pendaftaran sebelum fitur jalur ada); dianggap jalur tunggal.
  pathId         String?
  path           AdmissionPath?     @relation(fields: [pathId], references: [id])
  registrationNo String             @unique // nomor pendaftaran
  status         RegistrationStatus @default(PENDING)

  // Data calon siswa
  fullName   String
  gender     Gender
  birthPlace String?
  birthDate  DateTime?
  religion   String?
  address    String?
  phone      String? // kontak pendaftar (E.164)
  email      String?

  // Data wali/ortu
  parentName     String
  parentPhone    String
  parentRelation ParentRelation
  previousSchool String?

  // Dokumen (URL file yang diupload)
  docBirthCert  String?
  docFamilyCard String?
  docPhoto      String?
  docDiploma    String?

  // Seleksi
  score        Int?
  selectedRank Int?
  resultNote   String?
  // Bila diterima → siswa dibuat
  studentId    String?  @unique
  student      Student? @relation(fields: [studentId], references: [id])

  submittedAt DateTime  @default(now())
  verifiedAt  DateTime?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([schoolId])
  @@index([batchId])
  @@index([status])
  @@map("registrations")
}

enum RegistrationStatus {
  DRAFT
  PENDING // menunggu verifikasi
  VERIFIED // dokumen OK
  TESTED // sudah seleksi/tes
  ACCEPTED // diterima
  REJECTED // ditolak
  WAITLIST // cadangan
  WITHDRAWN // mengundurkan diri
}

// ============================================================
// ABSENSI
// ============================================================

model Attendance {
  id       String           @id @default(cuid())
  schoolId String
  school   School           @relation(fields: [schoolId], references: [id])
  date     DateTime         @db.Date
  status   AttendanceStatus
  note     String?

  // Salah satu dari siswa / guru
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id])
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], name: "TeacherAttendance")

  classId    String?
  class      Class?  @relation(fields: [classId], references: [id])
  scheduleId String? // bila absen per-mapel

  markedById String?
  markedBy   User?    @relation("AttendanceMarkedBy", fields: [markedById], references: [id])
  markedAt   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // === PENCEGAH DUPLIKAT ===
  // Absensi siswa: satu baris per (sekolah, tanggal, siswa) — mencegah
  // double-submit menghasilkan dua baris untuk siswa yang sama pada tanggal
  // yang sama. PostgreSQL menganggap NULL berbeda, sehingga entri khusus guru
  // (studentId NULL) maupun absen per-mapel tidak saling bertabrakan.
  @@unique([schoolId, date, studentId], name: "uniq_attendance_student_day")
  // Absensi per-mapel: satu baris per (sekolah, tanggal, jadwal, siswa).
  @@unique([schoolId, date, scheduleId, studentId], name: "uniq_attendance_schedule_student")
  @@index([schoolId, date])
  @@index([studentId, date])
  @@index([teacherId, date])
  @@map("attendances")
}

enum AttendanceStatus {
  PRESENT // hadir
  LATE // terlambat
  SICK // sakit
  EXCUSED // izin
  ABSENT // alpa
}

// ============================================================
// PENILAIAN
// ============================================================

/// Komponen nilai: UH, Tugas, UTS, UAS, dll
model GradeItem {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id])
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  teacherId      String
  teacher        Teacher      @relation(fields: [teacherId], references: [id])

  name     String // "UTS", "Tugas 1"
  type     GradeType
  weight   Int       @default(100) // bobot persen
  maxScore Int       @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grades Grade[]

  @@index([schoolId, subjectId])
  @@map("grade_items")
}

enum GradeType {
  ASSIGNMENT // tugas
  QUIZ // kuis/UH
  MIDTERM // UTS
  FINAL // UAS
  PRACTICUM // praktik
  PROJECT // proyek
}

model Grade {
  id          String    @id @default(cuid())
  schoolId    String
  gradeItemId String
  gradeItem   GradeItem @relation(fields: [gradeItemId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id])
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id])
  classId     String?
  class       Class?    @relation(fields: [classId], references: [id])
  semesterId  String?
  semester    Semester? @relation(fields: [semesterId], references: [id])

  score        Int
  note         String?
  recordedById String?
  recordedBy   User?    @relation("GradeCreatedBy", fields: [recordedById], references: [id])
  recordedAt   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gradeItemId, studentId])
  @@index([schoolId, studentId])
  @@map("grades")
}

/// Rapor final per siswa per semester per mapel
model ReportCard {
  id           String  @id @default(cuid())
  schoolId     String
  studentId    String
  semesterId   String
  subjectId    String // mapel
  finalScore   Int
  predicate    String? // A/B/C/D
  note         String?
  homeroomNote String? // catatan wali kelas untuk rapor PDF

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, semesterId, subjectId])
  @@index([schoolId])
  @@map("report_cards")
}

// ============================================================
// KEUANGAN: TAGIHAN & PEMBAYARAN
// ============================================================

/// Master tagihan (SPP, uang pangkal, seragam, dll)
model FeeType {
  id        String  @id @default(cuid())
  schoolId  String
  name      String // "SPP Bulanan", "Uang Pangkal"
  code      String
  amount    Int // nominal default (Rupiah)
  recurring Boolean @default(false) // berulang bulanan?
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices InvoiceItem[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("fee_types")
}

model Invoice {
  id        String  @id @default(cuid())
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id])
  studentId String
  student   Student @relation(fields: [studentId], references: [id])
  invoiceNo String  @unique
  title     String // "SPP Oktober 2025"

  totalAmount Int // total tagihan
  paidAmount  Int           @default(0)
  status      InvoiceStatus @default(UNPAID)
  dueDate     DateTime
  note        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  items       InvoiceItem[]
  payments    Payment[]
  gatewayTxns PaymentGatewayTransaction[]

  @@index([schoolId, studentId])
  @@index([status])
  @@map("invoices")
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeTypeId   String?
  feeType     FeeType? @relation(fields: [feeTypeId], references: [id])
  description String
  amount      Int
  quantity    Int      @default(1)

  @@index([invoiceId])
  @@map("invoice_items")
}

model PaymentMethod {
  id       String  @id @default(cuid())
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id])
  name     String // "Tunai", "Transfer BCA", "QRIS"
  code     String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("payment_methods")
}

model Payment {
  id        String         @id @default(cuid())
  schoolId  String
  invoiceId String
  invoice   Invoice        @relation(fields: [invoiceId], references: [id])
  amount    Int
  methodId  String?
  method    PaymentMethod? @relation(fields: [methodId], references: [id])
  paidAt    DateTime       @default(now())
  reference String? // no. referensi transfer
  proofUrl  String? // bukti bayar
  note      String?

  recordedById String?
  recordedBy   User?   @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, invoiceId])
  @@map("payments")
}

// ============================================================
// WEB SEKOLAH (PUBLIK) — IDENTITAS, HALAMAN, BLOK
// ============================================================

/// Tema visual satu sekolah.
///
/// Dibuat sebagai preset terkurasi (bukan pemilih warna bebas) supaya
/// kontras teks selalu aman. Sekolah memilih preset, boleh menyesuaikan
/// warna aksen, tetapi pasangan warna dasar sudah dijamin terbaca.
model SiteTheme {
  id       String @id @default(cuid())
  schoolId String @unique
  school   School @relation(fields: [schoolId], references: [id])

  /// Kode preset dari lib/site-themes.ts, mis. "akademik-biru".
  preset String @default("akademik-biru")

  /// Penyesuaian opsional (hex). Null = pakai warna preset.
  primaryColor String?
  accentColor  String?

  /// Pilihan huruf — hanya dari daftar yang tersedia.
  headingFont String @default("fraunces")
  bodyFont    String @default("public-sans")

  /// Sudut elemen: "tegas" | "lembut" | "bulat".
  cornerStyle String @default("lembut")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_themes")
}

/// Blok di halaman depan sekolah.
///
/// Inilah mekanisme "satu mesin, banyak wajah": kode blok milik produk,
/// tetapi SUSUNAN dan GAYA-nya milik sekolah. Setiap baris = satu blok.
model SiteBlock {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  /// Kunci jenis blok dari katalog (lib/site-blocks.ts), mis. "hero", "news".
  /// Tidak boleh blok yang sama muncul dua kali di satu halaman depan.
  blockKey   String
  /// Kunci varian gaya, mis. "hero.besar-tengah".
  variantKey String

  /// Urutan tampil (kecil = atas).
  order     Int     @default(0)
  isEnabled Boolean @default(true)

  /// Isi & pengaturan blok. Bentuknya berbeda per jenis blok; divalidasi
  /// terhadap skema Zod milik blok tersebut.
  props Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, blockKey])
  @@index([schoolId, order])
  @@map("site_blocks")
}

/// Halaman tambahan buatan sekolah (mis. /profil, /visi-misi, /sambutan).
///
/// Halaman depan ("/") tidak ada di sini — ia selalu dirender dari SiteBlock.
model Page {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  title String
  /// URL halaman tanpa garis miring, mis. "visi-misi".
  slug  String

  /// Isi halaman: teks kaya ringan (HTML dari editor terbatas).
  /// Halaman boleh kosong bila hanya memakai blok.
  content String @default("")

  /// Blok penyusun halaman (opsional). Bila kosong, `content` yang dipakai.
  blocks Json @default("[]")

  /// Tampilkan di menu navigasi utama?
  showInNav Boolean @default(true)
  /// Urutan di menu.
  navOrder  Int     @default(0)

  /// SEO
  metaTitle       String?
  metaDescription String?

  isPublished Boolean   @default(true)
  publishedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([schoolId, slug])
  @@index([schoolId])
  @@map("pages")
}

/// Item menu navigasi (header/footer) milik sekolah.
model NavigationItem {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  label String
  /// Tujuan: "/berita", "/spmb", atau URL penuh.
  href  String

  /// "header" | "footer" — dua area menu terpisah.
  area  String @default("header")
  order Int    @default(0)

  /// Buka di tab baru? (untuk tautan luar)
  isExternal Boolean @default(false)
  /// Hanya tampil bila sekolah punya SPMB aktif.
  onlyIfSpmb Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, area, order])
  @@map("navigation_items")
}

/// Pengaturan umum tampilan web sekolah (di luar tema).
model SiteConfig {
  id       String @id @default(cuid())
  schoolId String @unique
  school   School @relation(fields: [schoolId], references: [id])

  /// Slogan/tagline di header.
  tagline          String?
  /// Kalimat singkat di bawah nama sekolah (halaman depan).
  shortDescription String?

  /// Halaman depan memakai blok ("BLOCKS") atau satu halaman kustom ("SINGLE").
  homepageMode String @default("BLOCKS")

  /// Arahkan "berita" ke halaman luar? Null = pakai /berita internal.
  beritaUrl String?

  /// Nomor WA humas untuk tombol kontak cepat.
  contactWa String?

  /// Sosial media (opsional).
  facebookUrl  String?
  instagramUrl String?
  youtubeUrl   String?
  tiktokUrl    String?

  /// Google Maps embed atau tautan peta.
  mapsUrl String?

  /// Tampilkan jam operasional.
  officeHours String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_configs")
}

// ============================================================
// PENGUMUMAN & BERITA (WEB SEKOLAH)
// ============================================================

model Post {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id])
  title       String
  slug        String
  excerpt     String?
  content     String
  coverUrl    String?
  type        PostType  @default(NEWS)
  isPublished Boolean   @default(false)
  publishedAt DateTime?

  /// Khusus agenda: kapan kegiatan berlangsung & di mana.
  /// Disimpan terpisah dari `publishedAt` karena agenda bisa diterbitkan lebih
  /// awal daripada hari-H kegiatannya (lihat AGENTS.md: tanggal ≠ tanggal input).
  eventDate     DateTime?
  eventLocation String?

  authorId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([schoolId, slug])
  @@index([schoolId])
  @@index([schoolId, type, isPublished])
  @@map("posts")
}

enum PostType {
  NEWS
  ANNOUNCEMENT
  AGENDA
  GALLERY
}

model Announcement {
  id          String               @id @default(cuid())
  schoolId    String
  school      School               @relation(fields: [schoolId], references: [id])
  title       String
  body        String
  audience    AnnouncementAudience @default(ALL)
  sendWa      Boolean              @default(false) // kirim ke WA juga?
  waSentAt    DateTime?
  publishedAt DateTime             @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reads AnnouncementRead[]

  @@index([schoolId])
  @@map("announcements")
}

enum AnnouncementAudience {
  ALL
  STUDENTS
  PARENTS
  TEACHERS
  STAFF
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
  @@map("announcement_reads")
}

// ============================================================
// NOTIFIKASI WHATSAPP (via Baileys gateway)
// ============================================================

/// Template pesan WA per sekolah (per jenis notifikasi)
model NotificationTemplate {
  id       String  @id @default(cuid())
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id])
  key      String // "INVOICE_REMINDER", "ABSENT_ALERT", "GRADE_RELEASED"
  name     String
  body     String // gunakan {{nama}}, {{kelas}}, dll
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, key])
  @@index([schoolId])
  @@map("notification_templates")
}

/// Antrian pengiriman WA. Worker (wa-gateway) mengambil dari sini.
model NotificationQueue {
  id            String              @id @default(cuid())
  schoolId      String
  school        School              @relation(fields: [schoolId], references: [id])
  channel       NotificationChannel @default(WHATSAPP)
  to            String // nomor tujuan E.164 tanpa '+'
  recipientName String?
  templateKey   String? // referensi opsional ke template
  body          String // isi pesan final (sudah di-render)
  status        NotificationStatus  @default(QUEUED)
  priority      Int                 @default(5) // 1=tinggi ... 9=rendah

  // Hasil pengiriman
  attempts    Int       @default(0)
  lastError   String?
  sentAt      DateTime?
  waMessageId String?
  scheduledAt DateTime  @default(now()) // jadwal kirim (hormati jam wajar)

  refType String? // "INVOICE", "ATTENDANCE", "REGISTRATION"
  refId   String?

  // === BACKOFF & KUNCI PROSES ===
  // `nextAttemptAt` menyimpan waktu percobaan berikutnya setelah gagal, supaya
  // worker tidak menyerbu nomor yang sedang bermasalah (rate limit WhatsApp).
  nextAttemptAt DateTime?
  // `lockedAt` mencegah DUA worker memproses pesan yang sama sekaligus
  // (double-send). Worker mengklaim pesan dengan mengisi kolom ini.
  lockedAt      DateTime?
  lockedBy      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledAt])
  @@index([status, nextAttemptAt])
  @@index([schoolId])
  @@map("notification_queue")
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
  SMS
}

/// Template pesan WhatsApp per sekolah.
/// Dipakai agar sekolah bisa mengubah bunyi pesan tanpa menyentuh kode.
model MessageTemplate {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  /// Kunci teknis (panggilan dari kode), mis. "attendance.absent".
  key      String
  /// Nama ramah untuk admin, mis. "Pemberitahuan alpa".
  name     String
  category TemplateCategory @default(GENERAL)

  /// Isi pesan dengan variabel {{nama}}, {{kelas}}, dst.
  body        String
  /// Keterangan kapan pesan ini dikirim (ditampilkan di UI).
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, key])
  @@index([schoolId])
  @@map("message_templates")
}

enum TemplateCategory {
  ATTENDANCE
  GRADE
  FINANCE
  ANNOUNCEMENT
  ADMISSION
  GENERAL
}

/// Kampanye pengumuman: satu pesan ke banyak penerima.
model AnnouncementCampaign {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  title String
  body  String

  /// Audiens: ALL | CLASS | TEACHERS | PARENTS_OF_CLASS
  audienceType    String
  /// Terisi bila audiens per kelas.
  audienceClassId String?
  audienceClass   Class?  @relation(fields: [audienceClassId], references: [id])

  /// Berapa pesan yang dibuat & berapa yang sudah terkirim.
  recipientCount Int @default(0)

  createdById String?
  createdBy   User?   @relation("CampaignCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, createdAt])
  @@map("announcement_campaigns")
}

enum NotificationStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

/// Status koneksi WhatsApp per sekolah (dibaca dari wa-gateway).
model WaSession {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  /// Nama sesi di wa-gateway (folder kredensial).
  sessionName String    @unique
  /// Connected | Pairing | Disconnected | LoggedOut
  status      String    @default("Disconnected")
  phoneNumber String?
  lastQr      String?
  lastSeenAt  DateTime?
  lastError   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@map("wa_sessions")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id        String      @id @default(cuid())
  schoolId  String?
  school    School?     @relation(fields: [schoolId], references: [id])
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  action    AuditAction
  entity    String // nama model: "Invoice", "Grade"
  entityId  String?
  before    Json?
  after     Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  @@index([schoolId, entity])
  @@index([userId])
  @@map("audit_logs")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
}

// ============================================================
// JAM PELAJARAN (Jam ke-N)
// ============================================================

/// Master jam pelajaran per sekolah: jam ke-1 = 07:00–07:45, dst.
model TimeSlot {
  id         String  @id @default(cuid())
  schoolId   String
  school     School  @relation(fields: [schoolId], references: [id])
  slotNumber Int // jam ke-N
  startTime  String // "07:00"
  endTime    String // "07:45"
  label      String? // mis. "Upacara", "Istirahat"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules Schedule[]

  @@unique([schoolId, slotNumber])
  @@index([schoolId])
  @@map("time_slots")
}

// ============================================================
// RIWAYAT KELAS SISWA (kenaikan kelas / mutasi)
// ============================================================

model StudentClassHistory {
  id             String           @id @default(cuid())
  schoolId       String
  school         School           @relation(fields: [schoolId], references: [id])
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id])
  classId        String
  class          Class            @relation(fields: [classId], references: [id])
  academicYearId String
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id])
  result         ClassProgression // hasil akhir tahun itu
  note           String?

  createdAt DateTime @default(now())

  @@index([schoolId, studentId])
  @@index([academicYearId])
  @@map("student_class_histories")
}

enum ClassProgression {
  NAIK // naik kelas
  TINGGAL // tinggal kelas
  LULUS // lulus
  MUTASI // pindah sekolah
}

// ============================================================
// PEMBAYARAN VIA PAYMENT GATEWAY (Midtrans / Xendit)
// ============================================================

model PaymentGatewayTransaction {
  id          String          @id @default(cuid())
  schoolId    String
  school      School          @relation(fields: [schoolId], references: [id])
  invoiceId   String
  invoice     Invoice         @relation(fields: [invoiceId], references: [id])
  provider    GatewayProvider
  externalId  String          @unique // order_id / reference dari provider
  vaNumber    String? // nomor virtual account
  paymentLink String? // link pembayaran / QRIS
  amount      Int
  status      GatewayStatus   @default(PENDING)
  rawPayload  Json? // payload webhook mentah untuk audit
  paidAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // === IDEMPOTENSI WEBHOOK ===
  // Provider (terutama Midtrans) dapat mengirim ulang notifikasi yang sama.
  // `notificationKey` = sidik jari peristiwa (mis. "order_id:transaction_status:
  // status_code:gross_amount"). Sebelum memproses, sistem mengecek apakah kunci
  // ini sudah pernah ditangani — sehingga pembayaran TIDAK tercatat dua kali.
  notificationKey String?

  @@unique([schoolId, notificationKey], name: "uniq_gateway_notification")
  @@index([schoolId, invoiceId])
  @@index([status])
  @@map("payment_gateway_transactions")
}

enum GatewayProvider {
  MIDTRANS
  XENDIT
  MANUAL
}

/// Konfigurasi payment gateway per sekolah.
///
/// KEAMANAN: `serverKeyEnc` dan `clientKeyEnc` TIDAK disimpan sebagai teks
/// biasa. Keduanya dienkripsi AES-256-GCM memakai kunci dari environment
/// (PAYMENT_ENCRYPTION_KEY). Kolom hanya berisi ciphertext.
/// `serverKeyLast4` menyimpan 4 karakter terakhir untuk ditampilkan di UI
/// ("••••3f2a") tanpa perlu mendekripsi.
model SchoolPaymentGateway {
  id       String          @id @default(cuid())
  schoolId String
  school   School          @relation(fields: [schoolId], references: [id])
  provider GatewayProvider

  isActive    Boolean @default(false)
  /// "sandbox" | "production" — menentukan base URL yang dipakai adapter.
  environment String  @default("sandbox")

  /// Kredensial terenkripsi (ciphertext base64, bukan plaintext).
  serverKeyEnc   String?
  clientKeyEnc   String?
  /// 4 karakter terakhir server key, untuk ditampilkan tanpa dekripsi.
  serverKeyLast4 String?

  /// Kanal pembayaran yang diaktifkan (mis. ["qris","bca_va","gopay"]).
  channels String[] @default([])

  /// Awalan order_id agar mudah dikenali di dasbor provider.
  orderPrefix String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, provider])
  @@index([schoolId])
  @@map("school_payment_gateways")
}

enum GatewayStatus {
  PENDING
  SETTLEMENT
  EXPIRE
  REFUND
  FAILED
}

// ============================================================
// KOMERSIAL: PAKET LANGGANAN (SaaS)
// ============================================================

model Plan {
  id            String  @id @default(cuid())
  name          String // "Basic", "Pro", "Enterprise"
  code          String  @unique
  pricePerMonth Int // Rupiah
  maxStudents   Int     @default(100)
  features      Json? // daftar fitur aktif, mis. { "wa": true, "spmb": true }
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id        String             @id @default(cuid())
  schoolId  String             @unique
  school    School             @relation(fields: [schoolId], references: [id])
  planId    String
  plan      Plan               @relation(fields: [planId], references: [id])
  status    SubscriptionStatus @default(TRIAL)
  startedAt DateTime           @default(now())
  expiresAt DateTime
  autoRenew Boolean            @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}
