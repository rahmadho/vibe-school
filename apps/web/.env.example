# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://school:schoolpass@localhost:5432/schoolapp?schema=public"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# --- Aplikasi ---
NODE_ENV="development"
DEFAULT_TIMEZONE="Asia/Jakarta"

# --- WA Gateway (diisi Fase 7) ---
WA_GATEWAY_URL="http://localhost:3001"
WA_GATEWAY_TOKEN="ganti-token-rahasia"

# --- Payment Gateway ---
# Kunci enkripsi kredensial gateway (AES-256-GCM). WAJIB 64 karakter hex (32 byte).
# Buat dengan:  openssl rand -hex 32
# Tanpa kunci ini, sistem menolak menyimpan server key Midtrans/Xendit.
PAYMENT_ENCRYPTION_KEY=""
# Kredensial gateway diisi lewat UI (/dashboard/finance/gateway) dan disimpan
# terenkripsi di database — TIDAK ditaruh di berkas .env.

# --- Seed akun super-admin ---
SEED_SUPERADMIN_EMAIL="admin@schoolapp.local"
SEED_SUPERADMIN_PASSWORD="changeme12345"
