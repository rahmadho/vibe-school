{
  "name": "school-app",
  "version": "0.1.0",
  "private": true,
  "description": "Sistem Informasi Sekolah multi-tenant: web sekolah, SPMB, absensi, nilai, keuangan, notifikasi WhatsApp (Baileys).",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "start": "npm run start --workspace=web",
    "lint": "npm run lint --workspace=web",
    "typecheck": "npm run typecheck --workspace=web",
    "test": "npm run test --workspace=web",
    "prisma:generate": "npm run prisma:generate --workspace=web",
    "prisma:migrate": "npm run prisma:migrate --workspace=web",
    "prisma:deploy": "npm run prisma:deploy --workspace=web",
    "prisma:studio": "npm run prisma:studio --workspace=web",
    "db:seed": "npm run db:seed --workspace=web",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "wa": "npm run dev --workspace=wa-gateway",
    "wa:start": "npm run start --workspace=wa-gateway",
    "services:up": "docker compose up -d"
  },
  "engines": {
    "node": ">=20"
  }
}
